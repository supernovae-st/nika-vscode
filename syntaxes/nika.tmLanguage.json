{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nika Workflow",
  "scopeName": "source.nika",
  "fileTypes": [
    "nika.yaml"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#nika-line"
    },
    {
      "include": "#model-line"
    },
    {
      "include": "#top-level-keys"
    },
    {
      "include": "#verbs"
    },
    {
      "include": "#after-line"
    },
    {
      "include": "#task-fields"
    },
    {
      "include": "#block-sub-fields"
    },
    {
      "include": "#verb-sub-fields"
    },
    {
      "include": "#template-expression"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#null"
    }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.nika"
    },
    "nika-line": {
      "match": "^(nika)(:)\\s*([a-z][a-z0-9-]*)",
      "captures": {
        "1": {
          "name": "keyword.control.required.nika"
        },
        "2": {
          "name": "punctuation.separator.key-value.nika"
        },
        "3": {
          "name": "entity.name.function.workflow-name.nika"
        }
      }
    },
    "top-level-keys": {
      "patterns": [
        {
          "match": "^(nika|tasks)(:)",
          "captures": {
            "1": {
              "name": "keyword.control.required.nika"
            },
            "2": {
              "name": "punctuation.separator.key-value.nika"
            }
          }
        },
        {
          "match": "^(const|inputs|model|outputs|permits|run|secrets)(:)",
          "captures": {
            "1": {
              "name": "support.type.optional.nika"
            },
            "2": {
              "name": "punctuation.separator.key-value.nika"
            }
          }
        }
      ]
    },
    "verbs": {
      "patterns": [
        {
          "match": "^\\s+(infer)(:)",
          "captures": {
            "1": {
              "name": "constant.language.verb.infer.nika"
            },
            "2": {
              "name": "punctuation.separator.key-value.nika"
            }
          }
        },
        {
          "match": "^\\s+(exec)(:)",
          "captures": {
            "1": {
              "name": "string.other.verb.exec.nika"
            },
            "2": {
              "name": "punctuation.separator.key-value.nika"
            }
          }
        },
        {
          "match": "^\\s+(invoke)(:)",
          "captures": {
            "1": {
              "name": "support.type.verb.invoke.nika"
            },
            "2": {
              "name": "punctuation.separator.key-value.nika"
            }
          }
        },
        {
          "match": "^\\s+(agent)(:)",
          "captures": {
            "1": {
              "name": "keyword.control.verb.agent.nika"
            },
            "2": {
              "name": "punctuation.separator.key-value.nika"
            }
          }
        }
      ]
    },
    "task-fields": {
      "match": "^\\s+(after|for_each|group|lift|on_error|output|retry|returns|timeout|when|with)(:)",
      "captures": {
        "1": {
          "name": "support.type.field.nika"
        },
        "2": {
          "name": "punctuation.separator.key-value.nika"
        }
      }
    },
    "block-sub-fields": {
      "match": "^\\s+(backoff_ms|because|fail_fast|from|items|law|max_attempts|max_parallel|on_codes|recover|skip)(:)",
      "captures": {
        "1": {
          "name": "variable.other.property.nika"
        },
        "2": {
          "name": "punctuation.separator.key-value.nika"
        }
      }
    },
    "verb-sub-fields": {
      "match": "^\\s+(args|body|command|content|cwd|env|extract|goal|headers|json|max_iterations|max_tokens|max_turns|method|mode|model|params|prompt|resource|server|shell|stop_sequences|system|temperature|thinking|tool|tool_choice|tools|url|working_dir)(:)",
      "captures": {
        "1": {
          "name": "variable.other.property.nika"
        },
        "2": {
          "name": "punctuation.separator.key-value.nika"
        }
      }
    },
    "template-expression": {
      "match": "(\\$\\{\\{)([^}]+)(\\}\\})",
      "captures": {
        "1": {
          "name": "punctuation.definition.template.begin.nika"
        },
        "2": {
          "name": "variable.other.template.nika"
        },
        "3": {
          "name": "punctuation.definition.template.end.nika"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nika",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#template-expression"
            },
            {
              "name": "constant.character.escape.nika",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.nika",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#template-expression"
            }
          ]
        }
      ]
    },
    "numbers": {
      "match": "(?<=:\\s)\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.nika"
    },
    "booleans": {
      "match": "(?<=:\\s)(true|false)\\b",
      "name": "constant.language.boolean.nika"
    },
    "null": {
      "match": "(?<=:\\s)(null|~)\\b",
      "name": "constant.language.null.nika"
    },
    "model-line": {
      "match": "^(model)(:)\\s*([\\w.:/-]+)",
      "captures": {
        "1": {
          "name": "support.type.optional.nika"
        },
        "2": {
          "name": "punctuation.separator.key-value.nika"
        },
        "3": {
          "name": "support.constant.provider-name.nika"
        }
      }
    },
    "after-line": {
      "match": "^\\s+(after)(:)\\s*(\\{)([^}]*)(\\})",
      "captures": {
        "1": {
          "name": "support.type.field.nika"
        },
        "2": {
          "name": "punctuation.separator.key-value.nika"
        },
        "3": {
          "name": "punctuation.definition.dictionary.begin.nika"
        },
        "4": {
          "patterns": [
            {
              "match": "\\b(success|failure|skipped|terminal|unwind)\\b",
              "name": "keyword.control.predicate.nika"
            },
            {
              "match": "[a-z][a-z0-9_]*(?=\\s*:)",
              "name": "variable.other.task-reference.nika"
            }
          ]
        },
        "5": {
          "name": "punctuation.definition.dictionary.end.nika"
        }
      }
    }
  }
}
